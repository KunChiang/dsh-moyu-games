{
  "name": "dsh-moyu-games",
  "version": "0.4.1",
  "description": "摸鱼棋室：在 DSH 里边工作边和本地 AI 下五子棋、暗兽棋，玩扫雷，或叠一座摇摇欲坠的楼。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "assets",
    "screenshots.json"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "dsh-plugin",
    "gomoku",
    "game",
    "摸鱼"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2+": "compatible",
        "0.2.1-rc.2+": "compatible",
        "0.2.2-rc.1+": "compatible"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/KunChiang/dsh-moyu-games.git"
  },
  "homepage": "https://github.com/KunChiang/dsh-moyu-games",
  "bugs": {
    "url": "https://github.com/KunChiang/dsh-moyu-games/issues"
  },
  "icon": "./assets/icon-180.png"
}
